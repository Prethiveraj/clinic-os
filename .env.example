# Copy to .env (local) or add each line to Vercel → Settings → Environment Variables.
# Core values are checked by `npm run check:env`. Storage, payments and cron are optional.
# `npm run verify:integrations` exercises configured live services (including sending email).

# --- App ---
# Local: NEXTAUTH_URL=http://localhost:3000 and APP_BASE_DOMAIN=localhost
# (clinic sites then open at http://<slug>.localhost:3000).
# Production: your real domain, e.g. https://clinicgrowth.in and clinicgrowth.in
NEXTAUTH_URL="http://localhost:3000"
APP_BASE_DOMAIN="localhost"
# Any long random string. Generate: openssl rand -base64 32  (or see README)
NEXTAUTH_SECRET=
# Any long random string. Protects /api/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=
# Email that becomes the first admin when you run `npm run db:seed`.
SEED_ADMIN_EMAIL=
# Optional: address shown as "Contact us" on the site (defaults to SMTP_USER).
CONTACT_EMAIL=

# --- Database (PostgreSQL) ---
# Local:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/clinic_growth_os
# Neon:   paste the pooled connection string (ends with ?sslmode=require)
DATABASE_URL=

# --- Google Cloud: Places API (New) + PageSpeed Insights API ---
# One key with both APIs enabled works for both variables.
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# --- AI: Groq ---
GROQ_API_KEY=
# Optional: any Groq chat model id. Default: openai/gpt-oss-120b
# (llama-prompt-guard models are classifiers and will not work).
GROQ_MODEL=

# --- Email: Gmail SMTP (sign-in codes, blog approvals, photo reminders) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yourname@gmail.com"
# 16-character Google App Password (not your normal Gmail password), no spaces.
SMTP_PASS=
EMAIL_FROM="Clinic Growth <yourname@gmail.com>"

# --- Optional: Supabase Storage (owner-uploaded assets only; no Google photo mirroring) ---
# Project Settings → API: Project URL and the service_role key (server-only secret).
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
# A PUBLIC bucket you create in Storage, e.g. clinic-photos
SUPABASE_STORAGE_BUCKET="clinic-photos"

# --- Bot protection: Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Optional: Payments: Razorpay (test keys start rzp_test_, live keys rzp_live_) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

# --- Optional landing-page text ---
NEXT_PUBLIC_HERO_BADGE_TEXT="Built for Indian clinics"
# Comma-separated partner names for the logo row; leave empty to hide the row.
PARTNER_LOGOS=
